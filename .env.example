# LLM API 키. 비어 있으면 AI 기능은 연결되지 않은 상태로 동작합니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 로그인 쿠키 서명. 16자 이상. 비어 있으면 서버의 data/session.secret에 만듭니다.
SESSION_SECRET=

# S3 호환 저장소. 네 값이 모두 있을 때만 사진이 그곳으로 갑니다.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
